{
  "name": "obsidian-content-studio",
  "version": "0.2.0",
  "private": true,
  "description": "아이디어 노트 하나로 메시지를 찾고 코르크판에서 재료를 모으는 Obsidian 플러그인",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit && node scripts/build-css.mjs && node esbuild.config.mjs",
    "test": "node --experimental-strip-types tests/note.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "typescript": "^5.7.0"
  }
}
