{
  "name": "obsidian-content-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Write channel content from vault ideas with Claude Code and Codex, and manage it as a content database in Obsidian.",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "test": "vitest run",
    "check": "npm run test && npm run build",
    "package": "npm run check && node scripts/package.mjs",
    "smoke:cli": "node scripts/run-smoke.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "markdown-it": "14.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "obsidian": "1.14.4",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
